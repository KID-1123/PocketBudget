<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".PocketBudgetApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketBudget">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.EditTransactionActivity" android:exported="false" />
        <activity android:name=".ui.CategoriesActivity" android:exported="false" />
        <activity android:name=".ui.BudgetsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
    </application>
</manifest>
